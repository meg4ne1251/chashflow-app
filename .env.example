# ============================================
# 家計簿アプリ Docker 環境変数
# ============================================
# このファイルを .env にコピーして値を設定してください:
#   cp .env.example .env
#
# !! .env ファイルは絶対に Git にコミットしないでください !!
# ============================================

# --- PostgreSQL ---
POSTGRES_DB=kakeibo
POSTGRES_USER=kakeibo
POSTGRES_PASSWORD=          # 必須: 安全なパスワードを設定

# --- Backend ---
JWT_SECRET=                 # 必須: openssl rand -base64 48 で生成
DATABASE_MAX_POOL_SIZE=10

# --- Metrics (任意) ---
# /metrics を Prometheus 等ループバック以外からスクレイプする場合に設定する。
# 設定すると Authorization: Bearer <token> 認証が有効になる。
# 例: openssl rand -hex 32
METRICS_TOKEN=

# --- CORS ---
# 本番ドメインを指定 (カンマ区切りで複数可)
CORS_ALLOWED_ORIGINS=http://localhost

# --- Nginx ---
# ホスト側の公開ポート
LISTEN_PORT=80
